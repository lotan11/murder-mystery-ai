# Offline/scripted mode is the default. Copy to .env only if configuring locally.
# start.ps1 reads the file only when you explicitly pass -EnvFile .\.env
MYSTERY_DIALOGUE_PROVIDER=scripted
MYSTERY_ALLOW_PAID_AI=false
OPENAI_API_KEY=
MYSTERY_OPENAI_MODEL=
# Maximum attempted external requests per room, including failures; reset does not replenish it.
MYSTERY_AI_MAX_CALLS=5
MYSTERY_AI_TIMEOUT=4
# Continuous microphone transcription remains disabled unless both flags are explicitly enabled.
MYSTERY_TRANSCRIPTION_ENABLED=false
MYSTERY_ALLOW_PAID_TRANSCRIPTION=false
MYSTERY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MYSTERY_TRANSCRIPTION_USD_PER_MINUTE=0.003
MYSTERY_TRANSCRIPTION_SECONDS_PER_ROOM=900
MYSTERY_TRANSCRIPTION_TIMEOUT=12
